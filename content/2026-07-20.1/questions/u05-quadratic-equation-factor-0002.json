    {
      "stepId": "step-009",
      "beforeLatex": "3t^2+t-2=0",
      "operationText": "(8)でtの二次方程式を因数分解して解き、t=x-1からxに戻す。",
      "operationLatex": "(3t-2)(t+1)=0\\Rightarrow t=\\frac23,-1\\Rightarrow x=t+1",
      "afterLatex": "x=\\frac53,0",
      "reason": "t=x-1なのでx=t+1です。tの各値に1を足します。",
      "choices": [
        {
          "id": "choice-a",
          "text": "(8)で(3t-2)(t+1)=0としてtを求め、x=t+1でxに戻す。",
