    {
      "stepId": "step-004",
      "beforeLatex": "x^2+y^2,\\ x+y=8,\\ xy=12",
      "operationText": "(4)で(x+y)^2=x^2+2xy+y^2を使ってx^2+y^2を求める。",
      "operationLatex": "x^2+y^2=(x+y)^2-2xy=8^2-2\\cdot12",
      "afterLatex": "40",
      "reason": "64-24=40です。",
      "choices": [
        {
          "id": "choice-a",
          "text": "(4)のx^2+y^2を(x+y)^2-2xyにして、8と12を代入する。",
