  "sourceType": "imported",
  "problemType": "expression-value-basic",
  "problemText": "次の式の値を求めなさい。\n(1) a = 3 のとき，a² − 4a + 7 の値\n(2) x = −2，y = 5 のとき，−y(2x + y²) の値\n(3) a + b = √7 + 1，a − b = √7 − 1 のとき，a² − b² の値\n(4) x + y = 8，xy = 12 のとき，x² + y² の値\n(5) a = (√7 + √5)/2，b = (√7 − √5)/2 のとき，a² + b² の値\n(6) x = √3 + 2 のとき，x² + 1/x² の値",
  "problemLatex": "\\begin{array}{ll}(1)&a=3,\\ a^2-4a+7\\\\(2)&x=-2,\\ y=5,\\ -y(2x+y^2)\\\\(3)&a+b=\\sqrt7+1,\\ a-b=\\sqrt7-1,\\ a^2-b^2\\\\(4)&x+y=8,\\ xy=12,\\ x^2+y^2\\\\(5)&a=\\dfrac{\\sqrt7+\\sqrt5}{2},\\ b=\\dfrac{\\sqrt7-\\sqrt5}{2},\\ a^2+b^2\\\\(6)&x=\\sqrt3+2,\\ x^2+\\dfrac1{x^2}\\end{array}",
  "given": {
    "variables": [
      "a",
      "b",
      "x",
      "y"
    ],
    "conditions": [
      "代入や式変形を用いて、それぞれの式の値を求める。"
    ]
  },
  "answer": {
    "finalAnswerLatex": "(1)\\ 4,\\quad (2)\\ -105,\\quad (3)\\ 6,\\quad (4)\\ 40,\\quad (5)\\ 6,\\quad (6)\\ 14"
  },
  "solutionPlan": {
    "summary": "(1)(2)は数を代入し、(3)(4)は平方の公式を使う。(5)はa+bとabを先に求めてa^2+b^2=(a+b)^2-2abを使い、(6)は逆数を有理化してから平方を計算する。"
  },
  "solutionSteps": [
    {
      "stepId": "step-001",
      "beforeLatex": "a^2-4a+7,\\ a=3",
      "operationText": "(1)の式のaに3を代入して計算する。",
      "operationLatex": "3^2-4\\cdot3+7",
      "afterLatex": "4",
      "reason": "9-12+7=4です。",
      "choices": [
        {
          "id": "choice-a",
          "text": "(1)のaに3を代入し、3^2-4\\cdot3+7を計算する。",
          "latex": "4",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "(1)のaに-3を代入し、(-3)^2-4\\cdot(-3)+7を計算する。",
          "latex": "28",
          "isCorrect": false,
          "incorrectReason": "(1)で与えられた値は-3ではなく3です。"
        },
        {
          "id": "choice-c",
          "text": "(1)のaに3を代入し、3^2+4\\cdot3+7を計算する。",
          "latex": "28",
          "isCorrect": false,
          "incorrectReason": "元の式のaの項は+4aではなく-4aです。"
        }
      ]
    },
    {
      "stepId": "step-002",
      "beforeLatex": "-y(2x+y^2),\\ x=-2,y=5",
      "operationText": "(2)の式にx=-2、y=5を代入し、かっこの中から計算する。",
      "operationLatex": "-5(2(-2)+5^2)=-5(21)",
      "afterLatex": "-105",
      "reason": "2(-2)+25=21、よって-5\\cdot21=-105です。",
      "choices": [
        {
          "id": "choice-a",
          "text": "(2)にx=-2、y=5を代入し、-5(2(-2)+5^2)を計算する。",
          "latex": "-105",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "(2)にx=2、y=5を代入し、-5(2(2)+5^2)を計算する。",
          "latex": "-145",
          "isCorrect": false,
          "incorrectReason": "(2)のxの値は2ではなく-2です。"
        },
        {
          "id": "choice-c",
          "text": "(2)にx=-2、y=5を代入し、5(2(-2)+5^2)を計算する。",
          "latex": "105",
          "isCorrect": false,
          "incorrectReason": "式の先頭は-yなので、y=5を代入すると-5になります。"
        }
      ]
    },
    {
      "stepId": "step-003",
      "beforeLatex": "a^2-b^2,\\ a+b=\\sqrt7+1,\\ a-b=\\sqrt7-1",
      "operationText": "(3)で平方の差の公式を使い、与えられた2つの式をかける。",
      "operationLatex": "(a+b)(a-b)=(\\sqrt7+1)(\\sqrt7-1)=7-1",
      "afterLatex": "6",
      "reason": "a^2-b^2=(a+b)(a-b)です。",
      "choices": [
        {
          "id": "choice-a",
          "text": "(3)のa^2-b^2を(a+b)(a-b)にして、与えられた式をかける。",
          "latex": "6",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "(3)のa^2-b^2を(a+b)^2+(a-b)^2として計算する。",
          "latex": "16",
          "isCorrect": false,
          "incorrectReason": "平方の差は積(a+b)(a-b)で表します。"
        },
        {
          "id": "choice-c",
          "text": "(3)のa^2-b^2を(a+b)^2として計算する。",
          "latex": "8+2\\sqrt7",
          "isCorrect": false,
          "incorrectReason": "a^2-b^2は(a+b)^2ではなく、(a+b)(a-b)です。"
        }
