    "name": "連立方程式"
  },
  "gradeLevel": "junior-high-review",
  "difficulty": {
    "label": "standard",
    "score": 2
  },
  "sourceType": "imported",
  "problemType": "simultaneous-equation-elimination-basic",
  "problemText": "次の連立方程式を解きなさい。\n5x − 2y = 4，3x + y = 12",
  "problemLatex": "\\begin{cases}5x-2y=4\\\\3x+y=12\\end{cases}",
  "given": {
    "variables": [
      "x",
      "y"
    ],
    "conditions": [
      "2つの方程式をともに満たすx、yを求める。"
    ]
  },
  "answer": {
    "finalAnswerLatex": "x=\\frac{28}{11},\\quad y=\\frac{48}{11}"
  },
  "solutionPlan": {
    "summary": "yの係数を-2と2にそろえて2式を足し、yを消去してxを求める。求めたxを3x+y=12へ代入してyを求める。"
  },
  "solutionSteps": [
    {
      "stepId": "step-001",
      "beforeLatex": "\\begin{cases}5x-2y=4\\\\3x+y=12\\end{cases}",
      "operationText": "第2式を2倍してyの係数を2にし、第1式と足してyを消去する。",
      "operationLatex": "2(3x+y=12)\\Rightarrow6x+2y=24",
      "afterLatex": "11x=28",
      "reason": "yの係数が-2と2になるので、2式を足すとyの項が0になります。",
      "choices": [
        {
          "id": "choice-a",
          "text": "第2式を2倍して6x+2y=24とし、第1式と足す。",
          "latex": "(5x-2y)+(6x+2y)=4+24\\Rightarrow11x=28",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "第2式を-2倍して-6x-2y=-24とし、第1式と足す。",
          "latex": "(5x-2y)+(-6x-2y)=4-24\\Rightarrow-x-4y=-20",
          "isCorrect": false,
          "incorrectReason": "yの係数が-2と-2になるため、足してもyの項を消去できません。"
        },
        {
          "id": "choice-c",
          "text": "第2式を2倍して6x+y=24とし、第1式と足す。",
          "latex": "(5x-2y)+(6x+y)=4+24\\Rightarrow11x-y=28",
          "isCorrect": false,
          "incorrectReason": "式全体を2倍するので、yも2yになります。"
        }
      ]
    },
    {
      "stepId": "step-002",
      "beforeLatex": "11x=28",
      "operationText": "xの係数11を1にするために、両辺を11で割る。",
      "operationLatex": "x=\\frac{28}{11}",
      "afterLatex": "x=\\frac{28}{11}",
      "reason": "11xはxの11倍なので、両辺を11で割るとxが求まります。",
      "choices": [
        {
          "id": "choice-a",
          "text": "両辺を11で割る。",
          "latex": "x=\\frac{28}{11}",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "両辺を28で割る。",
          "latex": "x=\\frac{11}{28}",
          "isCorrect": false,
          "incorrectReason": "xの係数は11なので、xを求めるには11で割ります。"
        },
        {
          "id": "choice-c",
          "text": "右辺から11を引く。",
          "latex": "x=17",
          "isCorrect": false,
          "incorrectReason": "11はxにかかっている係数なので、引くのではなく両辺を11で割ります。"
        }
      ]
    },
    {
      "stepId": "step-003",
      "beforeLatex": "3x+y=12,\\quad x=\\frac{28}{11}",
      "operationText": "x=\\frac{28}{11}を3x+y=12へ代入し、yを求める。",
      "operationLatex": "3\\cdot\\frac{28}{11}+y=12\\Rightarrow y=\\frac{48}{11}",
      "afterLatex": "y=\\frac{48}{11}",
      "reason": "xの値を元の方程式へ戻すと、yだけの一次方程式になります。",
      "choices": [
        {
          "id": "choice-a",
          "text": "x=\\frac{28}{11}を3x+y=12へ代入する。",
          "latex": "\\frac{84}{11}+y=12\\Rightarrow y=\\frac{48}{11}",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "x=\\frac{28}{11}を3x-y=12のxに代入する。",
          "latex": "\\frac{84}{11}-y=12\\Rightarrow y=-\\frac{48}{11}",
          "isCorrect": false,
          "incorrectReason": "元の方程式のyの項は+yなので、-yにはなりません。"
        },
        {
          "id": "choice-c",
          "text": "x=\\frac{28}{11}を3+x+y=12のxに代入する。",
          "latex": "3+\\frac{28}{11}+y=12\\Rightarrow y=\\frac{71}{11}",
          "isCorrect": false,
          "incorrectReason": "3xは3とxの和ではなく、3とxの積です。"
        }
      ]
    }
  ],
