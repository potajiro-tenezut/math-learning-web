        {
          "id": "choice-c",
          "text": "y=\\frac{27}{5}を3x-2y=30のyに代入する。",
          "latex": "3x-\\frac{54}{5}=30\\Rightarrow x=\\frac{68}{5}",
          "isCorrect": false,
          "incorrectReason": "第1式のyの項は+2yなので、代入後も正のままです。"
        }
