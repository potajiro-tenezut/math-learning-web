  "sourceType": "adapted",
  "problemType": "quadratic-equation-formula-basic",
  "problemText": "解の公式を使って、次の二次方程式を解きなさい。\n2x² − 6x + 1 = 0",
  "problemLatex": "2x^2-6x+1=0",
  "given": {
    "variables": [
      "x"
    ],
    "conditions": [
      "解の公式を使って二次方程式を解く。"
    ]
  },
  "answer": {
    "finalAnswerLatex": "x=\\frac{3+\\sqrt7}{2},\\frac{3-\\sqrt7}{2}"
  },
  "solutionPlan": {
    "summary": "解の公式を確認し、左辺からa、b、cを読み取って代入する。判別式を計算した後、根号を簡単にし、分子と分母を約分して解を求める。"
  },
  "solutionSteps": [
    {
      "stepId": "step-001",
      "beforeLatex": "2x^2-6x+1=0",
      "operationText": "二次方程式ax^2+bx+c=0に使う解の公式を確認する。",
      "operationLatex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}",
      "afterLatex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}",
      "reason": "bの符号を変えた-bを分子に置き、分母は2a、根号の中はb^2-4acです。",
      "choices": [
        {
          "id": "choice-a",
          "text": "分子を-b±√(b^2-4ac)、分母を2aとする公式を使う。",
          "latex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "分子をb±√(b^2-4ac)、分母を2aとする公式を使う。",
          "latex": "x=\\frac{b\\pm\\sqrt{b^2-4ac}}{2a}",
          "isCorrect": false,
          "incorrectReason": "解の公式の分子の先頭はbではなく-bです。"
        },
        {
          "id": "choice-c",
          "text": "分子を-b±√(b^2-4ac)、分母をaとする公式を使う。",
          "latex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{a}",
          "isCorrect": false,
          "incorrectReason": "解の公式の分母はaではなく2aです。"
        }
      ]
    },
    {
      "stepId": "step-002",
      "beforeLatex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}",
      "operationText": "2x^2-6x+1の左辺をax^2+bx+cと見てa=2、b=-6、c=1を読み取り、解の公式に代入する。",
      "operationLatex": "x=\\frac{-(-6)\\pm\\sqrt{(-6)^2-4\\cdot2\\cdot1}}{2\\cdot2}",
      "afterLatex": "x=\\frac{6\\pm\\sqrt{36-8}}4",
      "reason": "x^2の係数がa、xの係数がb、定数項がcです。a=2、b=-6、c=1を符号を含めて代入します。",
      "choices": [
        {
          "id": "choice-a",
          "text": "左辺をax^2+bx+cと見てa=2、b=-6、c=1とし、解の公式の各部分へ代入する。",
          "latex": "x=\\frac{-(-6)\\pm\\sqrt{(-6)^2-4\\cdot2\\cdot1}}{2\\cdot2}=\\frac{6\\pm\\sqrt{36-8}}4",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "左辺をax^2+bx+cと見てa=2、b=6、c=1とし、解の公式の各部分へ代入する。",
          "latex": "x=\\frac{-6\\pm\\sqrt{6^2-4\\cdot2\\cdot1}}{2\\cdot2}=\\frac{-6\\pm\\sqrt{36-8}}4",
          "isCorrect": false,
          "incorrectReason": "xの項は-6xなので、b=-6です。分子の先頭は-(-6)=6になります。"
        },
        {
          "id": "choice-c",
          "text": "左辺をax^2+bx+cと見てa=1、b=-6、c=1とし、解の公式の各部分へ代入する。",
          "latex": "x=\\frac{-(-6)\\pm\\sqrt{(-6)^2-4\\cdot1\\cdot1}}{2\\cdot1}=\\frac{6\\pm\\sqrt{36-4}}2",
          "isCorrect": false,
          "incorrectReason": "x^2の係数は2なので、a=2です。分母は2a=4になります。"
        }
      ]
    },
    {
      "stepId": "step-003",
      "beforeLatex": "x=\\frac{6\\pm\\sqrt{36-8}}4",
      "operationText": "根号の中の36-8を計算する。",
      "operationLatex": "36-8=28",
      "afterLatex": "x=\\frac{6\\pm\\sqrt{28}}4",
      "reason": "b^2=36、4ac=8なので、判別式b^2-4acは28です。",
      "choices": [
        {
          "id": "choice-a",
          "text": "(-6)^2を36、4×2×1を8として、根号の中を36-8で計算する。",
          "latex": "36-8=28,\\quad x=\\frac{6\\pm\\sqrt{28}}4",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "(-6)^2を-36、4×2×1を8として、根号の中を-36-8で計算する。",
          "latex": "-36-8=-44,\\quad x=\\frac{6\\pm\\sqrt{-44}}4",
          "isCorrect": false,
          "incorrectReason": "負の数を2乗すると正になるので、(-6)^2=36です。"
        },
        {
          "id": "choice-c",
          "text": "(-6)^2を36、4×2×1を8として、根号の中を36+8で計算する。",
          "latex": "36+8=44,\\quad x=\\frac{6\\pm\\sqrt{44}}4",
          "isCorrect": false,
          "incorrectReason": "解の公式の根号の中はb^2-4acなので、36-8=28です。"
        }
      ]
    },
    {
      "stepId": "step-004",
      "beforeLatex": "x=\\frac{6\\pm\\sqrt{28}}4",
      "operationText": "28を4×7に分けて、√28を簡単にする。",
      "operationLatex": "\\sqrt{28}=\\sqrt{4\\cdot7}=2\\sqrt7",
      "afterLatex": "x=\\frac{6\\pm2\\sqrt7}4",
      "reason": "平方数4を根号の外に出すとき、√4=2になります。",
      "choices": [
        {
          "id": "choice-a",
          "text": "28を4×7に分け、√4を2として根号の外に出す。",
          "latex": "\\sqrt{28}=\\sqrt{4\\cdot7}=2\\sqrt7,\\quad x=\\frac{6\\pm2\\sqrt7}4",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "28を4×7に分け、4を根号の外に出す。",
          "latex": "\\sqrt{28}=4\\sqrt7,\\quad x=\\frac{6\\pm4\\sqrt7}4",
          "isCorrect": false,
          "incorrectReason": "根号の外に出るのは4ではなく√4=2です。"
        },
        {
          "id": "choice-c",
          "text": "28を2×14に分け、2を根号の外に出す。",
          "latex": "\\sqrt{28}=2\\sqrt{14},\\quad x=\\frac{6\\pm2\\sqrt{14}}4",
          "isCorrect": false,
          "incorrectReason": "根号の外へ出せるのは平方数の因数です。2は平方数ではないので、28=4×7を使います。"
        }
      ]
    },
    {
      "stepId": "step-005",
      "beforeLatex": "x=\\frac{6\\pm2\\sqrt7}4",
      "operationText": "分子の2項をそれぞれ分母4で割り、解を簡単にする。",
      "operationLatex": "x=\\frac64\\pm\\frac{2\\sqrt7}4=\\frac32\\pm\\frac{\\sqrt7}2",
      "afterLatex": "x=\\frac{3+\\sqrt7}2,\\frac{3-\\sqrt7}2",
      "reason": "6と2√7の両方が分母4で割られます。それぞれ2で約分できます。",
      "choices": [
        {
          "id": "choice-a",
          "text": "分子の6と2√7をそれぞれ分母4で割り、両方の分数を2で約分する。",
          "latex": "x=\\frac64\\pm\\frac{2\\sqrt7}4=\\frac32\\pm\\frac{\\sqrt7}2=\\frac{3\\pm\\sqrt7}2",
          "isCorrect": true
        },
        {
          "id": "choice-b",
          "text": "分子の6を分母4で割り、2√7を分母2で割って整理する。",
          "latex": "x=\\frac64\\pm\\frac{2\\sqrt7}2=\\frac32\\pm\\sqrt7",
          "isCorrect": false,
          "incorrectReason": "6と2√7は同じ分子にあるので、どちらも分母4で割ります。"
        },
        {
          "id": "choice-c",
          "text": "分子の6を分母2で割り、2√7を分母4で割って整理する。",
          "latex": "x=\\frac62\\pm\\frac{2\\sqrt7}4=3\\pm\\frac{\\sqrt7}2",
          "isCorrect": false,
          "incorrectReason": "6と2√7は同じ分子にあるので、どちらも分母4で割ります。"
        }
      ]
    }
